{
  "manifest_version": 3,
  "name": "EasyTrader Auto Clicker",
  "version": "1.0.0",
  "description": "Auto clicker for EasyTrader Trader",
  "action": {
    "default_popup": "popup.html",
    "default_title": "EasyTrader Auto Clicker",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://d.easytrader.ir/*"]
}